{:paths ["src"]
 :deps  {org.clojure/clojure {:mvn/version "1.13.0-alpha9"}}
 :aliases
 {:run    {:main-opts ["-m" "llm.core"]}
  :verify {:main-opts ["-m" "llm.core" "verify"]}
  :nrepl  {:extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}
           :main-opts  ["-m" "nrepl.cmdline" "--port" "7888"]}
  :backtest {:main-opts ["-m" "trade.core"]}}}
